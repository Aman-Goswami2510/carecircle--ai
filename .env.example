# CareCircle AI Environment Configuration Example

# Supabase (Optional for full cloud persistence, app runs complete high-fidelity mock & local engine out-of-the-box)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Notification Provider (Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=notifications@carecircle.ai

# Scheduled Reminder Cron Security Secret
CRON_SECRET=carecircle_hackathon_secure_cron_token_2026

# Application Base URL
NEXT_PUBLIC_APP_URL=https://carecircle-ai.vercel.app

